/* container: centered, responsive max-width & padding */
.text-section {
  @apply mx-auto mt-0 mb-24 pt-8 px-4 sm:px-6 lg:px-8;
}

/* heading styles */
.text-section h2 {
  @apply text-left text-2xl md:text-3xl font-semibold mb-4 border-b-4 border-[var(--color-accent)] pb-2;
}

/* subheading styles */
.text-section h3 {
  @apply text-left text-sm md:text-lg font-semibold mb-3;
}

/* theme-aware heading colors */
.text-section.dark h2,
.text-section.bg-dark h2,
.text-section .dark h2,
.text-section .bg-dark h2 {
  color: var(--color-white);
  border-color: var(--color-accent-light);
}

.text-section.light h3,
.text-section.bg-light h3,
.text-section .light h3,
.text-section .bg-light h3 {
  color: var(--color-primary-dark);
}

.text-section.dark h3,
.text-section.bg-dark h3,
.text-section .dark h3,
.text-section .bg-dark h3 {
  color: var(--color-white);
}

/* body text: prose fundamentals + custom tweaks */
.text-section {
  @apply text-[var(--color-text-body)];
}

/* ensure good line-height and spacing on paragraphs */
.text-section p {
  @apply text-left leading-relaxed mb-4;
}

/* link styles with clear hover state.
   accent-dark (not accent) for AA contrast on light backgrounds. */
.text-section a {
  @apply text-[var(--color-accent-dark)] underline transition;
}
.text-section a:hover {
  @apply text-[var(--color-secondary-dark)];
}
.text-section a:focus-visible {
  outline: 3px solid var(--color-secondary-dark);
  outline-offset: 2px;
}

.image-section .overlay {
  top: 50%; 
  left: 50%; 
  transform: translate(-50%, -50%);
}
