 .hero {
    max-height: calc(80svh - 96px);
    margin: 0 !important;
  }

  @media (max-width: 500px) {
    .hero {
      max-height: calc(60svh - 96px);
    }
  }

  @media (max-width: 380px) {
    .hero {
      max-height: calc(50svh - 96px);
    }
  }

 /* Heading. Matches .hero-tagline's scale — at text-base the mobile <h1> came out
    smaller than the body copy under it. */
 .hero h1 {
   @apply text-2xl md:text-5xl font-bold leading-tight whitespace-pre-wrap text-white mb-4;
   text-shadow: 0 4px 8px rgba(0,0,0,0.8);
 }

 /* Brand tagline — the visible hero heading (the SEO <h1> is sr-only) */
 .hero .hero-tagline {
   @apply text-2xl md:text-5xl font-bold leading-tight whitespace-pre-wrap text-white mb-4;
   text-shadow: 0 4px 8px rgba(0,0,0,0.8);
 }

 /* Subheading/body. text-wrap keeps the centered lines from breaking into a
    ragged stack with a one-word last line under the wide headline. */
 .hero .subtitle {
   @apply text-base md:text-xl font-semibold leading-relaxed text-white;
   text-shadow: 0 2px 4px rgba(0,0,0,0.6);
   text-wrap: pretty;
 }

 .hero h1,
 .hero .hero-tagline {
   text-wrap: balance;
 }

 @media (max-width: 380px) {
    .hero h1 {
      @apply text-base leading-snug mb-2;
    }
    .hero .hero-tagline {
      @apply text-base leading-snug mb-2;
    }
    .hero .subtitle {
      @apply text-sm leading-snug;
    }
 }

 /* CTA button/link */
 .hero .cta {
   @apply
     bg-[var(--color-off-white)]
     hover:bg-[var(--color-accent-dark)]
     text-[var(--color-accent-dark)]
     hover:text-[var(--color-off-white)]
     border-2
     border-[var(--color-accent-dark)]
     hover:border-[var(--color-off-white)]
     px-4
     py-2
     rounded
     transition
     drop-shadow
     focus:outline-none
     focus:ring-4
     focus:ring-[var(--color-accent-dark)]/50;
 }

  @media screen and (orientation: landscape) and (max-width: 1080px) {
    .hero {
      height: 90svh;
    }
    .hero h1 {
      @apply text-3xl leading-tight;
    }
    .hero p {
      @apply text-lg max-w-xl;
    }
  }

