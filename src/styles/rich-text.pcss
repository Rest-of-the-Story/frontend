/* Rich text — styles for everything rendered by <RichText> (CMS Portable Text).
   Single source of truth: sections set size/color on the wrapper and let these
   rules handle rhythm, lists, headings and links. Imported after the section
   stylesheets so it wins ties with rules like `.text-section h3`.

   #app centers text globally, so body copy resets to start-aligned here. */

.rich-text {
  text-align: start;
  overflow-wrap: break-word;
}

/* Vertical rhythm: space between blocks, none above the first or below the last */
.rich-text > * {
  margin-block: 0 1em;
}
.rich-text > :last-child {
  margin-bottom: 0;
}

.rich-text p {
  line-height: 1.65;
}

/* Lists — markers sit outside the text so wrapped lines align with the first
   line instead of tucking under the bullet. */
.rich-text ul,
.rich-text ol {
  padding-inline-start: 1.5em;
  list-style-position: outside;
}
.rich-text ul {
  list-style-type: disc;
}
.rich-text ol {
  list-style-type: decimal;
}
.rich-text ul ul {
  list-style-type: circle;
}
.rich-text li {
  line-height: 1.6;
  padding-inline-start: 0.25em;
}
.rich-text li + li {
  margin-top: 0.4em;
}
.rich-text li > ul,
.rich-text li > ol {
  margin-top: 0.4em;
}
.rich-text li::marker {
  color: var(--color-text-muted);
}

/* Headings inside body copy. Serif + uppercase for h2/h3 come from global.pcss. */
.rich-text h2,
.rich-text h3,
.rich-text h4 {
  line-height: 1.3;
  text-align: start;
}
.rich-text > :is(h2, h3, h4):not(:first-child) {
  margin-top: 1.75em;
}
/* Scale stays below page titles (text-3xl/4xl) so body headings never compete */
.rich-text h2 {
  font-size: 1.375rem;
  padding-bottom: 0.5rem;
  border-bottom: 3px solid var(--color-accent);
}
.rich-text h3 {
  font-size: 1.1875rem;
  font-weight: 600;
}
.rich-text h4 {
  font-size: 1.0625rem;
  font-weight: 700;
}
@media (min-width: 768px) {
  .rich-text h2 { font-size: 1.625rem; }
  .rich-text h3 { font-size: 1.375rem; }
  .rich-text h4 { font-size: 1.125rem; }
}

.rich-text blockquote {
  padding-inline-start: 1em;
  border-inline-start: 4px solid var(--color-accent);
  font-style: italic;
}

.rich-text img {
  width: 100%;
  height: auto;
  border-radius: 0.5rem;
}

/* Links are always underlined inside body copy so they don't rely on color alone
   (WCAG 1.4.1). Theme tokens keep contrast in light and dark mode. */
.rich-text a {
  color: var(--color-text-links);
  text-decoration: underline;
  text-underline-offset: 0.15em;
}
.rich-text a:hover {
  color: var(--color-text-links-hover);
  text-decoration-thickness: 2px;
}

/* Variants ---------------------------------------------------------------- */

/* On dark/brand backgrounds: inherit the section's light text color */
.rich-text--invert,
.rich-text--invert h2,
.rich-text--invert h3,
.rich-text--invert h4,
.rich-text--invert a,
.rich-text--invert a:hover,
.rich-text--invert li::marker {
  color: inherit;
}

.rich-text--center {
  text-align: center;
}
.rich-text--center :is(ul, ol) {
  display: inline-block;
  text-align: start;
}

.rich-text--compact > * {
  margin-bottom: 0;
}
