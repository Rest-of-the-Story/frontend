@import "tailwindcss";

@import './global.pcss';
@import './legal-pages.pcss';
/* page sections */
@import './navigation.pcss';
@import './hero.pcss';
@import './text-sections.pcss';
@import './forms.pcss';
@import './cards.pcss';
@import './blog.pcss';
@import './contact.pcss';
/* footer styles */
@import './footer.pcss';
/* CMS rich text — last so it wins ties with section rules */
@import './rich-text.pcss';

/* Brand "primary" color scale (navy). Must come AFTER all @import rules — CSS
   requires @import to precede other at-rules, so a @theme block placed above
   these imports silently drops every stylesheet after it. Without this scale,
   Tailwind v4 emits no CSS for primary-* utilities (invisible blog buttons). */
@theme {
  --color-primary-600: #415e76;
  --color-primary-700: #375069;
  --color-primary-800: #2d4254;
}
