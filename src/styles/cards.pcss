.cards {
 @apply mb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto;
}

.cards article {
 @apply flex flex-col rounded-lg shadow-md;
}

.cards h3 {
 @apply text-xl md:text-2xl mb-3;
}

.cards p {
 @apply text-left mb-6;
}

/* Card CTAs read as buttons against the white card, so they invert the shared
   .btn-cta (see global.pcss): brand green fill with a white label (6.0:1), and
   hover flips to sage with the dark brand ink (5.6:1). The old white-on-sage
   label measured 2.1:1 — legible only to people who already knew it was there. */
.cards .btn-cta {
  background: var(--color-accent-dark);
  color: #fff;
}
.cards .btn-cta:hover {
  background: var(--color-accent);
  color: var(--color-off-black);
}

.contact-cards a {
 @apply border-2 border-transparent hover:border-[var(--color-accent)] transition;
}